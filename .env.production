# 生产环境配置

# API基础路径
VITE_API_URL=/api

# 环境标识
VITE_APP_ENV=production

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=20000

# 是否启用接口请求日志
VITE_ENABLE_API_LOG=false

# 天气 ApiKey
VITE_OPENWEATHER_API_KEY=19c47a2e5b7d7624f98fbfa77dd9474e

# Weather Service Provider
VITE_WEATHER_PROVIDER=openweather

# Weather Cache Duration (minutes)
VITE_WEATHER_CACHE_DURATION=30

# DeepSeek ApiKey
VITE_DEEPSEEK_API_KEY=sk-f0b61fa318ec4eeb9b7064188e6486c1